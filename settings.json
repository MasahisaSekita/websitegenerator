{
  "template": "templates/electrician",
  "template_name": "Electrician · English template",
  "template_edit_policy": "business-details-and-theme-only",
  "dashboard_port": 4310,
  "batch_size": 5,
  "requested_workers": 5,
  "delivery": "file",
  "build_mode": "html",
  "website_prompt": "references/website-prompt.md",
  "jetai": {
    "upload": true,
    "api_base": "https://slides.yobolabs.ai/api/v1",
    "env_file": ".env",
    "key_name": "JETAI_API_KEY",
    "target": "prototype",
    "publish": false,
    "site_id": null,
    "app_url": ""
  },
  "generator": {
    "model": "sonnet",
    "max_parallel": 2,
    "poll_seconds": 10,
    "max_turns": 40,
    "timeout_minutes": 20,
    "repair_rounds": 2,
    "scrape_pages": 3,
    "claude_cli": "",
    "cloud_budget_minutes": 270
  },
  "discovery": {
    "country": "US",
    "first_result": 91,
    "results": 100,
    "max_queries": 6,
    "max_candidates": 30
  },
  "worker_model": "sonnet",
  "vercel_scope": "albertshineys-projects",
  "vercel_cli": [
    "npx",
    "--yes",
    "vercel@59.16.0"
  ],
  "firecrawl_env_file": ".env",
  "max_scrape_pages_per_business": 5,
  "max_discovery_candidates": 20,
  "sender": {
    "name": "Masahisa Sekita",
    "phone": "+62 811199919",
    "email": "masahisa.sekita@yobo.id",
    "first_name": "Masahisa",
    "last_name": "Sekita"
  },
  "outreach": {
    "submit_by_default": true,
    "operator_approval_required": true,
    "include_preview_link": true,
    "language": "en",
    "offer": "Website is free; the business pays for hosting.",
    "skip_required_surname": false,
    "allow_inspection_forms": true,
    "skip_captchas": true,
    "complete_after_submit": true,
    "message_mode": "fixed"
  },
  "default_template": "electrician",
  "templates": {
    "electrician": {
      "name": "Electrician · base design",
      "path": "templates/electrician"
    }
  },
  "personalization_fields": [
    "name",
    "phone",
    "email",
    "street",
    "city",
    "zip",
    "theme_color"
  ],
  "scouting": {
    "screening_mode": "firecrawl-first",
    "initial_pages_per_business": 2,
    "max_concurrent_business_scrapes": 2,
    "visual_assessment": "agent-views-saved-screenshot",
    "final_form_check": "live-browser"
  }
}
