# Copy to .env and fill in. settings.json points firecrawl_env_file at .env.

# Firecrawl API key for homepage/contact-page screening (tools/site_assets.py). Required for scouting.
FIRECRAWL_API_KEY=

# Optional: path to the SQLite ledger (tools/control.py). Defaults to data/revamp.sqlite3; leave commented unless overriding (an empty value breaks the default).
# REVAMP_DB=

# Optional: Chrome/Chromium binary for the template prerender script. Defaults to the macOS Google Chrome path,
# so on Windows set it, e.g. CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe (only needed for template edits).
CHROME_PATH=

# Optional: port for the copied prerender script's static server (tools/site_assets.py clone); empty picks a free port.
PRERENDER_PORT=

# Optional: Google Apps Script edition (apps-script/README.md). When both are set, the ledger lives in Google Sheets
# and every ledger command runs through tools/sheets_ledger.py instead of tools/control.py.
# REVAMP_SHEETS_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# REVAMP_SHEETS_TOKEN=
